# Token from @BotFather (keep it secret, never commit it)
GLN_BOT_TOKEN=

# Comma-separated Telegram user IDs allowed to use /stats and /broadcast
ADMIN_IDS=

# Optional: where the SQLite database file lives (default: ./gln_bot.db)
GLN_DB_PATH=gln_bot.db

# Optional: Postgres connection string (Neon pooled connection). When set,
# the bot uses Postgres instead of SQLite - required on Render, whose disk
# is ephemeral.
DATABASE_URL=
